{
  "manifest_version": 3,
  "name": "Gesit Integration",
  "version": "1.1.0",
  "description": "Send downloads and videos from your browser to Gesit, the fast multi-connection download manager for Linux and Windows.",
  "key": "__KEY__",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "cookies",
    "webRequest",
    "contextMenus",
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gesit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
